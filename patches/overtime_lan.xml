<?xml version="1.0" encoding="utf-8"?>
<!--
  Overtime dev patches for NHL 19 (CUSA11126, v1.60), applied in memory by shadPS4: pass this file to tools/run_game.py (patch option).
  Addresses are eboot vaddr + 0x400000 (shadPS4 subtracts 0x400000 for non-offset lines). See docs/notes/shadps4-network.md.
-->
<Patch>
  <!-- ProtoHttp polls sceHttpGetStatusCode while a non-blocking request is in flight and only treats 0x80431065 as
       "not ready"; shadPS4 answers 0x80431082 (EAGAIN), so every request was dropped. cmp eax, imm32 at 0x3890812. -->
  <Metadata Name="ProtoHttp: accept EAGAIN while waiting for the status code" AppVer="01.60" AppElf="eboot.bin" isEnabled="true">
    <PatchList>
      <Line Type="bytes" Address="0x3C90813" Value="82104380"/>
    </PatchList>
  </Metadata>
  <!-- Redirector host "spring18.gosredirector.ea.com" (0x4ddccff) -> "192.168.1.15", so no hosts-file entry is needed. -->
  <Metadata Name="Redirector host: 192.168.1.15" AppVer="01.60" AppElf="eboot.bin" isEnabled="true">
    <PatchList>
      <Line Type="bytes" Address="0x51DCCFF" Value="3139322E3136382E312E313500"/>
    </PatchList>
  </Metadata>
  <!-- QosClient copies its 'ncrt' flag (state+0xe467) into the ProtoSSL ref before the coordinator request
       (mov cl, [rbx+0xe467] at 0x385aa16). mov cl, 1 disables cert validation for the QoS coordinator link only. -->
  <Metadata Name="QoS coordinator: skip TLS cert validation" AppVer="01.60" AppElf="eboot.bin" isEnabled="true">
    <PatchList>
      <Line Type="bytes" Address="0x3C5AA16" Value="B10190909090"/>
    </PatchList>
  </Metadata>
  <!-- Nucleus prod base URLs (flat 0x4e6e089 accounts, 0x4e6e0a2 gateway, 0x4e6e0ba signin) -> https://localhost/
       (the stub serves HTTPS on 443). The login state machine calls {accounts}connect/auth, connect/token, ... -->
  <Metadata Name="Nucleus hosts: 192.168.1.15" AppVer="01.60" AppElf="eboot.bin" isEnabled="true">
    <PatchList>
      <Line Type="bytes" Address="0x526E089" Value="68747470733A2F2F3139322E3136382E312E31352F00"/>
      <Line Type="bytes" Address="0x526E0A2" Value="68747470733A2F2F3139322E3136382E312E31352F00"/>
      <Line Type="bytes" Address="0x526E0BA" Value="68747470733A2F2F3139322E3136382E312E31352F00"/>
    </PatchList>
  </Metadata>
  <!-- By Kravickas (github.com/Kravickas/ps4_cheats, PATCHES/NHL19.xml "60 FPS replays", CUSA11116 v1.60; the same
       bytes in CUSA11126 v1.60). The video-out flip rate: mov ebx, 3 at 0x28ec8df -> mov ebx, 1 and the cmovl ebx, eax
       at 0x28ec8ef -> nop, so replays and the other 30 fps sequences flip every vblank. -->
  <Metadata Name="60 FPS replays (Kravickas)" AppVer="01.60" AppElf="eboot.bin" isEnabled="true">
    <PatchList>
      <Line Type="bytes" Address="0x2CEC8DF" Value="BB01000000"/>
      <Line Type="bytes" Address="0x2CEC8EF" Value="909090"/>
    </PatchList>
  </Metadata>
  <!-- By Kravickas (github.com/Kravickas/ps4_cheats, PATCHES/NHL19.xml "Resolution 2560x1440 (16:9)", CUSA11116 v1.60;
       the same bytes in CUSA11126 v1.60). The render size immediates at 0x293bd70..0x293bdaa (1600x900 and 1920x1080)
       -> 2560x1440, and 0x1736ea -> cave 0x4a35077 (text padding) scales a video memory size to match. Off by default
       (1080p): the Setup tab's Resolution choice turns it on, with Additional DMem 3500 MB (gamesetup.DMEM_1440). -->
  <Metadata Name="Resolution 2560x1440 (Kravickas)" AppVer="01.60" AppElf="eboot.bin" isEnabled="false">
    <PatchList>
      <Line Type="bytes" Address="0x2D3BD70" Value="B8000A0000"/>
      <Line Type="bytes" Address="0x2D3BD75" Value="BA000A0000"/>
      <Line Type="bytes" Address="0x2D3BD7A" Value="B9A0050000"/>
      <Line Type="bytes" Address="0x2D3BD7F" Value="BEA0050000"/>
      <Line Type="bytes" Address="0x2D3BDAA" Value="41C74558000A0000"/>
      <Line Type="bytes" Address="0x5736EA" Value="E988198C049090"/>
      <Line Type="bytes" Address="0x4E35077" Value="483D00000040721348B90000C090000000004839C8740448C1E001498B0E483B4DE8E953E673FB"/>
    </PatchList>
  </Metadata>
  <!-- By Kravickas ("Resolution 1280x720 (16:9)", NHL 19 v1.60, PatchVer 1.0). The render size immediates at
       0x293bd70..0x293bdaa (res1440's in-place lines) -> 1280x720, 921 600 pixels: below the stock 1600x900, so no
       memory line is needed. Off by default: the Setup tab's Resolution choice turns it on (res1440 off). -->
  <Metadata Name="Resolution 1280x720 (Kravickas)" AppVer="01.60" AppElf="eboot.bin" isEnabled="false">
    <PatchList>
      <Line Type="bytes" Address="0x2D3BD70" Value="B800050000"/>
      <Line Type="bytes" Address="0x2D3BD75" Value="BA00050000"/>
      <Line Type="bytes" Address="0x2D3BD7A" Value="B9D0020000"/>
      <Line Type="bytes" Address="0x2D3BD7F" Value="BED0020000"/>
      <Line Type="bytes" Address="0x2D3BDAA" Value="41C7455800050000"/>
    </PatchList>
  </Metadata>
  <!-- Online Threes' setup builds the unlock lists (herounlocks / mascotunlocks) in 0x1406990: each hero or mascot
       reward's player id is looked up (equal_range) in a sorted {id, def} vector with no not-found check, so a missing
       id reads the def pointer one entry past the end (heap garbage; 0xc0000005 at 0x1406fc5 in most runs, docs/notes/
       threes-otp.md 10.4). Hook 0x1406fbd -> cave 0x56eb200 (text padding): found takes the entry as before; not found
       goes to 0x1406fd3, where the live ZF makes the existing cmovz write 0xffff (the code's own "no asset" value). -->
  <Metadata Name="T1: not-found check on the Threes unlock lookup" AppVer="01.60" AppElf="eboot.bin" isEnabled="true">
    <PatchList>
      <Line Type="bytes" Address="0x1806FBD" Value="E93E422E04909090"/>
      <Line Type="bytes" Address="0x5AEB200" Value="740C4989C8498B4008E9B7BDD1FBE9C0BDD1FB"/>
    </PatchList>
  </Metadata>
  <!-- Intel and AMD CPUs return other low bits for vrcpps / vrsqrtps, so two games in lockstep drift apart
       (docs/notes/cross-vendor-desync.md). shadPS4 swaps most estimates for AMD's results; the 262 sites
       its pass cannot reach jump (260 hooks) to caves in text padding (0x56ea4b0..0x56ec000, around
       the R1/BAP32/T1 caves) that compute exact vdivps / vsqrtps, the same bits on every x86 CPU, then run the
       instructions the hook overwrote and jump back. Generated (re/scripts/build_crossvendor_patch.py) for the v1.60
       eboot only. -->
